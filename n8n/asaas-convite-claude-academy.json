    {
      "parameters": {
        "jsCode": "const inv = $input.first().json;\nconst cust = $('Buscar cliente Asaas').first().json;\nconst nome = cust.name || '(sem nome)';\nconst email = cust.email || '(sem e-mail)';\nconst ok = inv.statusCode === 200;\nconst painel = 'https://claudeacademy.chatjuridico.com.br/admin';\nlet text;\nif (ok) {\n  text = '✅ *Convite Claude Academy enviado* (assinatura Asaas)\\nNome: ' + nome + '\\nE-mail: ' + email;\n} else {\n  const body = inv.body || {};\n  const erro = body.error || ('HTTP ' + inv.statusCode);\n  text = '⚠️ *Convite NÃO saiu automático — gere na mão* (assinatura Asaas)\\nNome: ' + nome + '\\nE-mail: ' + email + '\\nErro: ' + erro + '\\nPainel de convites: ' + painel;\n}\nreturn [{ json: { slackText: text, ok: ok, nome: nome, email: email } }];"
      },
