# Defina "true" para ativar auth e APIs Supabase. Omitido ou != true = inativo (sem middleware/auth).
# NEXT_PUBLIC_SUPABASE_ENABLED=true

# Cadastro em /signup em produção (padrão: desligado). Só em dev local sem esta var segue o Supabase acima.
# NEXT_PUBLIC_SIGNUP_ENABLED=true

# Supabase (projeto em https://supabase.com, Authentication > Providers > Email)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role: APENAS servidor (API /api/auth/signup). Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Segredo para POST /api/invites via script/CLI (opcional). Painel /admin usa login admin.
INVITE_ADMIN_SECRET=gerar-string-longa-aleatoria

# Admins do painel /admin: e-mail @chatjuridico.com.br cadastrado na tabela admin_users (Supabase).
# Exemplo SQL: insert into public.admin_users (email) values ('voce@chatjuridico.com.br');

# URL pública do site (Supabase redirect URLs, metadata, OG, links de verificação)
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://claudeacademy.chatjuridico.com.br

# Link do convite do grupo WhatsApp (obrigatório em produção)
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/G2VXJ9UManZ77Rx7Uzn7NT

# WhatsApp de suporte do curso (padrão: +55 11 93621-6714)
# NEXT_PUBLIC_SUPPORT_WHATSAPP=5511936216714

# Checkout da página /curso (opcional: sem URL, CTAs abrem WhatsApp com mensagem pré-preenchida)
# NEXT_PUBLIC_CHECKOUT_INSTALLMENTS_URL=https://pay.example.com/12x
# NEXT_PUBLIC_CHECKOUT_UPFRONT_URL=https://pay.example.com/avista

# Lista de espera: formulário POST no website (padrão chatjuridico.com.br/api/claude-academy-waitlist)
# NEXT_PUBLIC_WAITLIST_API_URL=https://chatjuridico.com.br/api/claude-academy-waitlist

# ─── Supabase ───────────────────────────────────────────────────────────────
# Rode supabase/setup-completo.sql no SQL Editor antes de ativar auth abaixo.
