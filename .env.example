# URL pública do site (produção)
NEXT_PUBLIC_SITE_URL=https://claudeacademy.chatjuridico.com.br

# Defina "true" para ativar auth e APIs Supabase. Omitido ou != true = modo demo SOMENTE em localhost.
# NEXT_PUBLIC_SUPABASE_ENABLED=true

# Supabase — projeto dedicado Claude Academy (ver supabase/README.md)
# Rode supabase/setup-completo.sql ou migrations 001–007 no SQL Editor antes de ativar.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role: APENAS servidor (API /api/auth/signup). Nunca expor no cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Fonte do conteúdo do curso. Sem isto (ou != "db"), o runtime lê o catálogo
# estático (course.yml) + overlay de lesson_overrides — comportamento atual.
# Defina "db" APÓS aplicar a migração 014 e rodar db:seed, para ler das tabelas
# nativas courses/modules/lessons (cutover reversível — ver PRD course-db-native).
# COURSE_SOURCE=db

# Secret do endpoint de provisionamento POST /api/access/grant (máquina-a-máquina).
# Cria a conta do e-mail (idempotente) e devolve um magic link pronto. Com
# { "sendEmail": true } o próprio endpoint envia o link por e-mail (SendGrid) e
# não o retorna. Usado pelo n8n no pós-pagamento do Asaas. Trate como credencial
# de alto valor (concede login). Header: Authorization: Bearer <secret> ou
# x-api-key: <secret>. Gere com: openssl rand -hex 32
# ACCESS_GRANT_SECRET=

# Admins do painel /admin: npm run admin:create (ou insert em admin_users)
# Domínios: @chatjuridico.com.br, @escritoriovilasboas.com
# TEST_ADMIN_EMAIL=seu@chatjuridico.com.br  # e2e do /admin (tests/e2e/admin-course.spec.ts)

# Link do convite do grupo WhatsApp (obrigatório em produção)
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/G2VXJ9UManZ77Rx7Uzn7NT

# WhatsApp de suporte do curso (padrão: +55 11 93621-6714)
# NEXT_PUBLIC_SUPPORT_WHATSAPP=5511936216714

# Checkout da página /curso (opcional: os links do ASAAS já vêm no código, ver src/lib/pricing.ts)
# NEXT_PUBLIC_CHECKOUT_INSTALLMENTS_URL=https://pay.example.com/12x
# NEXT_PUBLIC_CHECKOUT_UPFRONT_URL=https://pay.example.com/avista
# Destino da rota /voucher (50% off) — não aparece na página de vendas
# NEXT_PUBLIC_CHECKOUT_VOUCHER_URL=https://pay.example.com/voucher

# Lista de espera — /api/waitlist encaminha p/ o mesmo endpoint do popup do
# chatjuridico.com.br, que avisa no Slack. Default já aponta p/ produção; defina
# só para sobrescrever (ex.: webhook de teste ou voltar pro n8n).
# WAITLIST_FORWARD_URL=https://chatjuridico.com.br/api/claude-academy-waitlist/
# NEXT_PUBLIC_WAITLIST_API_URL=/api/waitlist

# SendGrid — envio de e-mails transacionais (APENAS servidor). Necessário para o
# e-mail de acesso do fluxo pós-pagamento (/api/access/grant com sendEmail: true)
# e para o e-mail do convite (/api/invites/issue).
# SENDGRID_API_KEY=SG.xxxxxxxx
# SENDGRID_FROM_EMAIL=no-reply@chatjuridico.com.br
# SENDGRID_FROM_NAME=Claude Academy

# Secret do endpoint de emissão de convite POST /api/invites/issue (máquina-a-
# máquina). Cria o convite em invite_tokens e envia o link /signup?token= por
# e-mail (SendGrid). Usado pelo n8n no pós-assinatura do Asaas. Secret dedicado
# (privilégio mínimo: só emite convite, não concede login como o de acesso).
# Header: Authorization: Bearer <secret> ou x-api-key: <secret>.
# Gere com: openssl rand -hex 32
# INVITE_ISSUE_SECRET=

# Asaas — consumidos pelo FLUXO n8n (n8n/asaas-convite-claude-academy.json), não
# pelo app Next. Defina-os no ambiente do n8n (ou como credenciais). Mantidos
# aqui/Vercel só para referência e caso o app passe a falar com o Asaas.
#   ASAAS_API_KEY        chave da API Asaas p/ GET cliente. Guarde SEM o "$"; o
#                        fluxo concatena o "$" no header access_token ao usar.
#   ASAAS_WEBHOOK_TOKEN  token que o Asaas manda no header asaas-access-token.
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
