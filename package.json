{
  "name": "claude-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run course:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "course:build": "node scripts/build-course-content.mjs",
    "course:video-seed": "node scripts/course-video-seed.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "qr": "node scripts/generate-qr.mjs",
    "favicon": "node scripts/generate-favicon.mjs",
    "invite": "node scripts/generate-invite.mjs",
    "admin:create": "node scripts/create-admin.mjs",
    "db:seed": "node scripts/seed-course-db.mjs",
    "db:seed:legacy": "node scripts/generate-course-seed.mjs",
    "audit": "node scripts/security-audit.mjs",
    "audit:live": "node scripts/security-audit.mjs --live",
    "audit:report": "node scripts/security-audit.mjs --write-report",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:security:live": "node --test tests/security/*.test.mjs",
    "test:auth": "node --test tests/auth/*.test.mjs",
    "playwright:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test": "npm run test:security && npm run test:auth",
    "test:unit": "tsx --test tests/unit/slug.test.ts tests/unit/ordering.test.ts tests/unit/merge.test.ts tests/unit/module-access.test.ts tests/unit/db-course.test.ts tests/unit/progress.test.ts tests/unit/packs.test.ts tests/unit/certificates.test.ts tests/unit/coming-soon.test.ts tests/unit/lesson-move.test.ts tests/unit/admin-dnd.test.ts tests/unit/admin-grouping.test.ts tests/unit/admin-lesson-move-bounds.test.ts tests/unit/admin-format.test.ts tests/unit/catalog-fallback.test.ts tests/unit/module-legacy-fields.test.ts"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.7.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "js-yaml": "^4.3.0",
    "playwright": "^1.59.1",
    "qrcode": "^1.5.4",
    "satori": "^0.26.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
